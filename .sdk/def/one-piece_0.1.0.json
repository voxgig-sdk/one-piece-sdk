  "components": {
    "schemas": {
      "Saga": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the saga"
          },
          "name": {
            "type": "string",
            "description": "Name of the saga"
          },
          "description": {
            "type": "string",
            "description": "Description of the saga"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Chapter IDs included in this saga"
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Episode IDs included in this saga"
          }
        }
      },
      "Fruit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the Devil Fruit"
          },
          "name": {
            "type": "string",
            "description": "Name of the Devil Fruit"
          },
          "type": {
            "type": "string",
            "description": "Type of Devil Fruit (Paramecia, Zoan, Logia)"
          },
          "description": {
            "type": "string",
            "description": "Description of the Devil Fruit's powers"
          },
          "user": {
            "type": "string",
            "description": "Current or known user of the fruit"
          }
        }
      },
      "Chapter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the chapter"
          },
          "number": {
            "type": "integer",
            "description": "Chapter number"
          },
          "title": {
            "type": "string",
            "description": "Title of the chapter"
          },
          "releaseDate": {

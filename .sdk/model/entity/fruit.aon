# Entity: fruit

main: kit: entity: fruit: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description of the Devil Fruit's powers"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the Devil Fruit"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the Devil Fruit"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of Devil Fruit (Paramecia, Zoan, Logia)"
      type: "`$STRING`"
    }
    {
      name: "user"
      req: false
      short: "Current or known user of the fruit"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "fruit"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/fruits"
          parts: [
            "fruits"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/fruits/{id}"
          parts: [
            "fruits"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

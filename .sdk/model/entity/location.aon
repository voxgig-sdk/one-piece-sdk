# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description of the location"
      type: "`$STRING`"
    }
    {
      name: "firstAppearance"
      req: false
      short: "First appearance of this location"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the location"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the location"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of location (island, sea, etc.)"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/locations"
          parts: [
            "locations"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/locations/{id}"
          parts: [
            "locations"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

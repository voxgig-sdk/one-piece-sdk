# Entity: gear

main: kit: entity: gear: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description of the gear's abilities"
      type: "`$STRING`"
    }
    {
      name: "firstAppearance"
      req: false
      short: "First appearance of this gear"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the gear"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the gear form"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "gear"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/gears"
          parts: [
            "gears"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/gears/{id}"
          parts: [
            "gears"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

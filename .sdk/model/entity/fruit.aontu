# Entity: fruit

main: kit: entity: fruit: {

  alias: field: {}

  fields: {
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Description of the Devil Fruit's powers"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the Devil Fruit"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the Devil Fruit"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Type of Devil Fruit (Paramecia, Zoan, Logia)"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "Current or known user of the fruit"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "fruit"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /fruits"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/fruits"
          s: [
            {
              lit: "fruits"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /fruits/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/fruits/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "fruits"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

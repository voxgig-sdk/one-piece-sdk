# Entity: technique

main: kit: entity: technique: {

  alias: field: {}

  fields: {
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Description of the technique"
      t: "`$STRING`"
    }
    gear: {
      h: "Gear"
      n: "gear"
      r: false
      sh: "Associated gear form if applicable"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the technique"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the technique"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "technique"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /techniques"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/techniques"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "techniques"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /techniques/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/techniques/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "techniques"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

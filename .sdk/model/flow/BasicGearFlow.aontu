# BasicGearFlow

main: kit: flow: BasicGearFlow:
{
  entity: "gear",
  kind: "basic",
  name: "BasicGearFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "gear_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "gear_ref01",
        srcdatavar: "gear_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "gear01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-gear_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGearFlow"
}